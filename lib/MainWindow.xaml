<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeBoost" Width="1240" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Theme brushes (light defaults; replaced at runtime for dark mode) -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#616161"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA3"/>
    <SolidColorBrush x:Key="AccentFgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A0F6CBD"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckBorderBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ScrollBrush" Color="#C2C2C2"/>
    <SolidColorBrush x:Key="LogBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="SevBigBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="SevBigBgBrush" Color="#1AC42B1C"/>
    <SolidColorBrush x:Key="SevWarnBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="SevWarnBgBrush" Color="#1F9D5D00"/>
    <SolidColorBrush x:Key="SevOkBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SevOkBgBrush" Color="#1A0F7B0F"/>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
              <Border x:Name="ov" Background="Transparent" CornerRadius="5"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ov" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ov" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Height="38">
              <Grid>
                <Border x:Name="pill" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Visibility="Hidden"/>
                <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Checkbox -->
    <Style x:Key="SBCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0"
                      BorderBrush="{DynamicResource CheckBorderBrush}" Background="{DynamicResource InputBrush}">
                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                           Foreground="{DynamicResource AccentFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Search box -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Height="34">
              <Grid Margin="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{DynamicResource SubTextBrush}" FontSize="13"/>
                <TextBlock x:Name="ph" Grid.Column="1" Margin="10,0,0,0" Text="{TemplateBinding Tag}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin scrollbars -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{DynamicResource ScrollBrush}"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SBProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="2"/>
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MaxWidth" Value="380"/>
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition/>
      </Grid.RowDefinitions>

      <!-- ===== Title bar ===== -->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentFgBrush}" FontSize="13" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="SafeBoost" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <Border Margin="10,0,0,0" CornerRadius="4" Padding="6,1" Background="{DynamicResource HoverBrush}" VerticalAlignment="Center">
            <TextBlock x:Name="TxtVersion" Text="v2.0" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
          </Border>
          <Border x:Name="BadgeDryRun" Margin="8,0,0,0" CornerRadius="4" Padding="6,1" Background="{DynamicResource SevWarnBgBrush}" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Preview mode" FontSize="11" Foreground="{DynamicResource SevWarnBrush}"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnTheme" Style="{StaticResource ChromeBtn}" ToolTip="Switch light / dark theme">
            <TextBlock x:Name="GlyphTheme" Text="&#xE708;" Style="{StaticResource Glyph}" FontSize="13"/>
          </Button>
          <Button x:Name="BtnMin" Style="{StaticResource ChromeBtn}"><TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
          <Button x:Name="BtnMax" Style="{StaticResource ChromeBtn}"><TextBlock x:Name="GlyphMax" Text="&#xE922;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
          <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="236"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Grid Margin="10,6,10,14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <RadioButton x:Name="NavOverview" Style="{StaticResource NavBtn}" IsChecked="True">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" FontSize="15" Width="28"/><TextBlock Text="Overview" VerticalAlignment="Center"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavTweaks" Style="{StaticResource NavBtn}">
              <Grid Width="182">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15" Width="28"/><TextBlock Text="Tweaks" VerticalAlignment="Center"/></StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="9" MinWidth="22" Padding="6,1" Background="{DynamicResource AccentSoftBrush}">
                  <TextBlock x:Name="NavTweaksCount" Text="0" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
              </Grid>
            </RadioButton>
            <RadioButton x:Name="NavApps" Style="{StaticResource NavBtn}">
              <Grid Width="182">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" FontSize="15" Width="28"/><TextBlock Text="Apps" VerticalAlignment="Center"/></StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="9" MinWidth="22" Padding="6,1" Background="{DynamicResource AccentSoftBrush}">
                  <TextBlock x:Name="NavAppsCount" Text="0" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
              </Grid>
            </RadioButton>
            <RadioButton x:Name="NavApply" Style="{StaticResource NavBtn}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="15" Width="28"/><TextBlock Text="Review &amp; apply" VerticalAlignment="Center"/></StackPanel>
            </RadioButton>
            <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}" Margin="10,10"/>
            <RadioButton x:Name="NavUndo" Style="{StaticResource NavBtn}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="15" Width="28"/><TextBlock Text="Backups &amp; undo" VerticalAlignment="Center"/></StackPanel>
            </RadioButton>
          </StackPanel>

          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{DynamicResource SevOkBrush}"/>
                <TextBlock Text="Safe by design" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,0"
                         Text="Restore point and a backup of every value before each run. Undo any time &#x2014; nothing Windows needs is ever removed."/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===== Content ===== -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBrush}" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Overview -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="36,30,36,28">
                <TextBlock Text="Overview" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="14"
                           Text="SafeBoost checks your PC first, then applies only safe, reversible tweaks. Nothing changes until you press Apply."/>
                <UniformGrid x:Name="StatTiles" Columns="4" Margin="-6,22,-6,0"/>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                  <StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="PC health check" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                      </StackPanel>
                      <TextBlock x:Name="HealthStatus" Text="Scanning your PC..." Style="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,8" FontSize="12"
                               Text="These hardware and driver settings usually matter more for FPS than any tweak. SafeBoost never changes them for you."/>
                    <StackPanel x:Name="FindingsPanel"/>
                  </StackPanel>
                </Border>

                <TextBlock Text="Choose a starting point" Style="{StaticResource H2}" Margin="0,26,0,12"/>
                <UniformGrid x:Name="PresetPanel" Columns="4" Margin="-6,0"/>
              </StackPanel>
            </ScrollViewer>

            <!-- Tweaks -->
            <Grid x:Name="PageTweaks" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel Margin="36,30,36,0">
                <TextBlock Text="Tweaks" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="14"
                           Text="Every tweak says exactly what it does. Hover any tweak for the full explanation."/>
                <Grid Margin="0,18,0,14">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnPresetSafe" Style="{StaticResource BtnBase}" Content="Safe" Margin="0,0,6,0"/>
                    <Button x:Name="BtnPresetGaming" Style="{StaticResource BtnBase}" Content="Gaming (recommended)" Margin="0,0,6,0"/>
                    <Button x:Name="BtnPresetMax" Style="{StaticResource BtnBase}" Content="Max" Margin="0,0,6,0"/>
                    <Button x:Name="BtnClear" Style="{StaticResource BtnBase}" Content="Clear selection"/>
                  </StackPanel>
                  <TextBox x:Name="TweakSearch" Style="{StaticResource SearchBox}" Tag="Search tweaks" Width="260" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="TweakColumns" Margin="36,0,30,24">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel x:Name="TweakCol0" Grid.Column="0" Margin="0,0,7,0"/>
                  <StackPanel x:Name="TweakCol1" Grid.Column="1" Margin="7,0,7,0"/>
                  <StackPanel x:Name="TweakCol2" Grid.Column="2" Margin="7,0,0,0"/>
                </Grid>
              </ScrollViewer>
            </Grid>

            <!-- Apps -->
            <Grid x:Name="PageApps" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel Margin="36,30,36,0">
                <TextBlock Text="Apps" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="14"
                           Text="Remove preinstalled and sponsored apps. Store, Xbox / Game Pass, Edge, codecs and driver panels are protected and never listed."/>
                <Grid Margin="0,18,0,14">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnAppsRecommended" Style="{StaticResource BtnBase}" Content="Select recommended" Margin="0,0,6,0"/>
                    <Button x:Name="BtnAppsAll" Style="{StaticResource BtnBase}" Content="Select all installed" Margin="0,0,6,0"/>
                    <Button x:Name="BtnAppsNone" Style="{StaticResource BtnBase}" Content="Clear" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkOnlyInstalled" Style="{StaticResource SBCheck}" Content="Only show installed" IsChecked="True" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="AppsStatus" Style="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Looking for installed apps..."/>
                </Grid>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,0,30,24">
                  <Border Style="{StaticResource Card}" Padding="8,6">
                    <UniformGrid x:Name="AppsGrid" Columns="2"/>
                  </Border>
                  <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="4,10,0,0"
                             Text="Removed apps can be reinstalled free from the Microsoft Store at any time."/>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- Review & apply -->
            <Grid x:Name="PageApply" Visibility="Collapsed" Margin="36,30,36,20">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Review &amp; apply" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="14"
                           Text="Check the summary, choose your safety options, then apply. You can undo everything later."/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,20,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Summary" Style="{StaticResource H2}"/>
                    <UniformGrid Columns="3" Margin="0,12,0,4">
                      <StackPanel><TextBlock x:Name="SumTweaks" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="tweaks" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="SumApps" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="apps to remove" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel><TextBlock x:Name="SumRestart" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="need a restart" Style="{StaticResource Sub}"/></StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="SumList" Style="{StaticResource Sub}" FontSize="12" Margin="0,10,0,0" MaxHeight="52" TextTrimming="WordEllipsis"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Safety options" Style="{StaticResource H2}"/>
                    <CheckBox x:Name="ChkRestorePoint" Style="{StaticResource SBCheck}" IsChecked="True" Margin="0,14,0,0">
                      <StackPanel><TextBlock Text="Create a System Restore point first" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Recommended. Takes about a minute." Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkDryRun" Style="{StaticResource SBCheck}" Margin="0,12,0,0">
                      <StackPanel><TextBlock Text="Preview only (dry run)" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Shows every change without making it." Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkAllUsers" Style="{StaticResource SBCheck}" Margin="0,12,0,0">
                      <StackPanel><TextBlock Text="Remove apps for all users" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Also stops them installing for new accounts." Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                    </CheckBox>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                  <Grid Margin="18,14,18,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Activity" Style="{StaticResource H2}"/>
                      <TextBlock x:Name="ApplyStatus" Text="Ready when you are." Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button x:Name="BtnOpenBackup" Style="{StaticResource BtnBase}" Content="Open backup folder" Margin="0,0,8,0" Visibility="Collapsed"/>
                      <Button x:Name="BtnRestart" Style="{StaticResource BtnBase}" Content="Restart now" Margin="0,0,8,0" Visibility="Collapsed"/>
                      <Button x:Name="BtnApply" Style="{StaticResource PrimaryBtn}" Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource AccentFgBrush}"/>
                          <TextBlock x:Name="BtnApplyText" Text="Apply changes" Margin="8,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <ProgressBar x:Name="ApplyProgress" Grid.Row="1" Style="{StaticResource SBProgress}" Margin="18,0,18,10" Maximum="100" Value="0"/>
                  <Border Grid.Row="2" Background="{DynamicResource LogBrush}" CornerRadius="0,0,8,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel x:Name="LogPanel" Margin="18,10"/>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Border>
            </Grid>

            <!-- Backups & undo -->
            <Grid x:Name="PageUndo" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel Margin="36,30,36,0">
                <TextBlock Text="Backups &amp; undo" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="14"
                           Text="Every run is saved here. Undo restores each setting to its exact previous value."/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,14">
                  <Button x:Name="BtnUndoFolder" Style="{StaticResource BtnBase}" Content="Open backup folder" Margin="0,0,6,0"/>
                  <Button x:Name="BtnSystemRestore" Style="{StaticResource BtnBase}" Content="Open System Restore" Margin="0,0,6,0"/>
                  <Button x:Name="BtnUndoRefresh" Style="{StaticResource BtnBase}" Content="Refresh"/>
                </StackPanel>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,0,30,24">
                  <StackPanel x:Name="RunsPanel"/>
                  <TextBlock x:Name="UndoStatus" Style="{StaticResource Sub}" Margin="4,12,0,0"/>
                  <Border x:Name="UndoLogCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed" Background="{DynamicResource LogBrush}">
                    <StackPanel x:Name="UndoLogPanel"/>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="36,12">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
                  <TextBlock x:Name="FooterSummary" Margin="8,0,0,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Text="Nothing selected yet"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="BtnBack" Style="{StaticResource BtnBase}" Margin="0,0,8,0" MinWidth="96">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="11"/><TextBlock Text="Back" Margin="8,0,0,0"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}" MinWidth="110">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="BtnNextText" Text="Next" Foreground="{DynamicResource AccentFgBrush}"/><TextBlock Text="&#xE72A;" Style="{StaticResource Glyph}" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/></StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
